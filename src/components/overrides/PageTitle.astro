---
import Default from '@astrojs/starlight/components/PageTitle.astro';
import PipelineTrail from '@/components/docs/PipelineTrail.astro';
import { CATALOG, pageSlug } from '@/data/catalog';
import { stageFor } from '@/lib/pipeline';
import { withBase } from '@/lib/url';

const route = Astro.locals.starlightRoute;
const id = route.id.replace(/\/$/, '');
const entry = CATALOG.find((e) => e.page && pageSlug(e) === id);
// Pages outside the catalog take their label from their section.
const sections: Record<string, string> = {
	'data-preparation': 'Data Preparation',
	validation: 'Validation',
	testing: 'Testing',
	concepts: 'Concepts',
	'distance-metrics': 'Distance Metrics',
};
const eyebrow = entry?.family ?? sections[id.split('/')[0]];
const stage = stageFor(id);
const body = route.entry.body ?? '';
// Guides have no algorithm to compare, and gridworld agents have no dataset to share.
const comparable = entry && !entry.page?.path && entry.family !== 'Reinforcement Learning';
const jumps = [
	body.includes('<Sandbox') && { label: 'Try the sandbox', href: '#interactive-sandbox', primary: true },
	body.includes('## Code') && { label: 'See the code', href: '#code', primary: false },
	comparable && { label: 'Compare with another', href: withBase(`/compare/?a=${entry.page!.id}`), primary: false },
].filter((jump) => !!jump);
---

{stage && <PipelineTrail stage={stage} />}
{eyebrow && <p class="page-eyebrow">{eyebrow}</p>}
<Default />
{
	jumps.length > 0 && (
		<div class="page-jumps">
			{jumps.map((jump) => (
				<a href={jump.href} class:list={['page-jump', { 'page-jump-primary': jump.primary }]}>
					{jump.label}
				</a>
			))}
		</div>
	)
}

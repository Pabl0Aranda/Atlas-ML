---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import AlgorithmCard from '@/components/ui/AlgorithmCard.astro';
import FamilyCard from '@/components/ui/FamilyCard.astro';
import { ALGORITHM_PAGE_COUNT, CATALOG, SANDBOX_COUNT } from '@/data/catalog';
import { withBase } from '@/lib/url';

const workflow = [
	{ title: 'Prepare', text: 'Clean the data, separate it, and process it into numbers.', href: '/data-preparation/overview/' },
	{ title: 'Train', text: 'Choose an algorithm and fit it to the training set.', href: '/catalog/' },
	{ title: 'Validate', text: 'Compare models and tune settings on held-out data.', href: '/validation/overview/' },
	{ title: 'Test', text: 'Measure the final model once, honestly.', href: '/testing/overview/' },
];

const stats = [
	{ value: SANDBOX_COUNT, label: 'interactive sandboxes' },
	{ value: ALGORITHM_PAGE_COUNT, label: 'algorithms explained' },
	{ value: CATALOG.length, label: 'catalog entries' },
];

const tools = [
	{ title: 'Compare algorithms', text: 'Run two side by side on identical data.', href: '/compare/' },
	{ title: 'Performance indicators', text: 'What each metric means, and how to choose one.', href: '/validation/indicators/' },
	{ title: 'Validation matrices', text: 'Read a confusion matrix and its relatives.', href: '/validation/validation-matrices/' },
	{ title: 'Distance metrics', text: 'See how each way of measuring changes a model.', href: '/distance-metrics/overview/' },
];

const families = [
	{ family: 'Supervised Learning', description: 'Learn to predict from labeled examples.', preview: 'decision-tree', dataset: 'xor' },
	{ family: 'Unsupervised Learning', description: 'Find structure in data with no labels.', preview: 'k-means', dataset: 'blobs' },
	{ family: 'Statistical Learning', description: 'Model uncertainty with probability and penalties.', preview: 'gaussian-mixture-models', dataset: 'blobs' },
	{ family: 'Reinforcement Learning', description: 'Learn to act through rewards and penalties.', preview: 'q-learning', dataset: 'trend' },
	{ family: 'Deep Learning', description: 'Stack neural layers to learn rich patterns.', preview: 'mlp', dataset: 'moons' },
] as const;

const startHere = ['K-Means Clustering', 'Decision Trees', 'Q-Learning'].map((name) => CATALOG.find((e) => e.name === name)!);
---

<StarlightPage
	frontmatter={{
		title: 'See how machine learning actually works',
		description: 'Find any machine learning algorithm, watch it run, read the math and inspect the code.',
		template: 'splash',
		hero: {
			title: 'See how machine learning actually works',
			tagline: 'Run algorithms step by step, follow the math, then read the exact code behind every animation.',
			image: {
				html: `<figure class="hero-live" data-hero-live><canvas aria-hidden="true"></canvas><figcaption><span>k-means, running live</span><span data-hero-step></span></figcaption></figure>`,
			},
			actions: [
				{ text: 'Start here', link: withBase('/start-here/'), icon: 'right-arrow' },
				{ text: 'Browse the catalog', link: withBase('/catalog/'), variant: 'minimal' },
			],
		},
	}}
	hasSidebar={false}
>
	<div class="not-content">
		<dl class="m-0 grid grid-cols-3 gap-4 border-y border-(--viz-border) py-6">
			{stats.map((s) => (
				<div>
					<dd class="font-display m-0 text-2xl font-semibold sm:text-3xl">{s.value}</dd>
					<dt class="text-xs text-(--viz-muted-ink) sm:text-sm">{s.label}</dt>
				</div>
			))}
		</dl>

		<section id="workflow" class="mt-14 scroll-mt-24">
			<h2 class="m-0 text-2xl font-semibold sm:text-3xl">The workflow, end to end</h2>
			<p class="m-0 mt-2 text-(--viz-muted-ink)">Every project follows the same four stages. Pick one to begin.</p>
			<ol class="m-0 mt-6 grid list-none gap-3 p-0 sm:grid-cols-2 lg:grid-cols-4">
				{workflow.map((step, i) => (
					<li class="m-0">
						<a href={withBase(step.href)} class="atlas-card h-full p-4">
							<span class="flex size-7 items-center justify-center rounded-full bg-(--sl-color-accent) text-sm font-semibold text-(--on-accent)">{i + 1}</span>
							<span class="font-display mt-3 block text-lg font-semibold">{step.title}</span>
							<span class="mt-1 block text-sm leading-snug text-(--viz-muted-ink)">{step.text}</span>
						</a>
					</li>
				))}
			</ol>
		</section>

		<section class="mt-14">
			<h2 class="m-0 text-2xl font-semibold sm:text-3xl">Explore by category</h2>
			<div class="mt-6 grid gap-3 md:grid-cols-2">
				{families.map((f) => <FamilyCard {...f} />)}
			</div>
		</section>

		<section class="mt-14">
			<h2 class="m-0 text-2xl font-semibold sm:text-3xl">Tools and references</h2>
			<ul class="m-0 mt-6 grid list-none gap-3 p-0 sm:grid-cols-2 lg:grid-cols-4">
				{tools.map((tool) => (
					<li class="m-0">
						<a href={withBase(tool.href)} class="atlas-card h-full p-4">
							<span class="font-display block text-lg font-semibold">{tool.title}</span>
							<span class="mt-1 block text-sm leading-snug text-(--viz-muted-ink)">{tool.text}</span>
						</a>
					</li>
				))}
			</ul>
		</section>

		<section class="mt-14">
			<div class="flex flex-wrap items-baseline justify-between gap-2">
				<h2 class="m-0 text-2xl font-semibold sm:text-3xl">Good places to start</h2>
				<a href={withBase('/catalog/')} class="text-sm font-medium text-(--sl-color-text-accent)">All {CATALOG.length} entries →</a>
			</div>
			<div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
				{startHere.map((entry) => <AlgorithmCard entry={entry as any} />)}
			</div>
		</section>
	</div>
</StarlightPage>

<script>
	import '@/lib/viz/heroCanvas';
</script>
